                {
                  "id": "21becf1d-9ba4-4095-b056-8db10b5fc317",
                  "title": " Bypass del Frontend — CRUD no autorizado",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Un atacante puede descubrir la URL directa de la API en Node.js y enviar peticiones POST o DELETE maliciosas saltándose el frontend en React, eliminando o alterando libros del inventario directamente.",
                  "mitigation": "Implementar validación estricta de tokens JWT en cada ruta de Express.js para que solo usuarios autenticados ejecuten acciones CRUD.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "5.75"
                },
                {
                  "id": "f6c7026e-95ef-4baf-82c2-0cb66ff3fe20",
                  "title": "DoS al endpoint de la calculadora",
                  "status": "Open",
                  "severity": "High",
                  "type": "Denial of service",
                  "description": "Un atacante puede enviar miles de peticiones simultáneas al endpoint de cálculo en Express.js, saturando el servidor Node.js y dejando el sistema de inventario completamente inoperativo.",
                  "mitigation": "Implementar Rate Limiting en Express.js para bloquear IPs que realicen demasiadas solicitudes en un corto período de tiempo (ej: express-rate-limit).",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "4"
                }
              ],
